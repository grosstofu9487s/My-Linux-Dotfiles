{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/Still_Still_Stellar.png",
    "padding": {
      "left": 1
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "packages",
    "shell",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    {
	"type": "command",
	"key": "Power Profile",
	"text": "powerprofilesctl get"
    },
    "swap",
    "disk",
    "break"
  ]
}
