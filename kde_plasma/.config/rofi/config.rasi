@import "colour.rasi"

* {
    font:   "psudoFont Liga Mono 12";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;

    bg2:    #3D3D3D80;
    fg0:    #E6E6E6;
    fg1:    #FFFFFF;
    fg2:    #969696;
    fg3:    #3D3D3D;
}

window {
    location:       north;
    y-offset:       calc(50% - 176px);
    width:          1050;
    border-radius:  5px;
    border:	3px;
    border-color:  @bg3;
    background-color:   @bg0;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;
    border-radius:  5px;
    border:         3px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg1;
}

entry {
    text-color:		@text;
}

message {
    margin:             12px 0 0;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     12px 0 0;
    lines:      8;
    columns:    1;


    border: 	0;
    fixed-height: false;
}



scrollbar{
    handle-color:  		 transparent;
    handle-width:		 0px;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  5px;
}

element normal.normal {
    background-color:            transparent;
    text-color: #adaddd;
}

element alternate.normal{
    background-color:            transparent;
    text-color: #adaddd;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

element selected normal, element selected active {
    background-color:   @bg3;
    text-color: @text;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
